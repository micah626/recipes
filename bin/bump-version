#!/bin/sh
# Stamp a new version so installed copies of the app refresh themselves.
# Run from the repo root after any change, before committing.
set -e
v=$(date +%s)
printf '{"v":"%s"}\n' "$v" > version.json
sed -i.bak -E "s/(window\.APP_V=\")[0-9]+/\1$v/; s/(recipes\.js\?v=)[0-9]+/\1$v/" index.html
rm -f index.html.bak
echo "Version $v"
